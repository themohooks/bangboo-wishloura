<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal network security config for VPN app.
  Adjust trust anchors for production if using custom CA on your server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
